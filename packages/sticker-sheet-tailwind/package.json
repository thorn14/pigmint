{
  "name": "@pigmint/sticker-sheet-tailwind",
  "version": "0.0.0",
  "private": true,
  "description": "Verification surface for the Tailwind adapter. Renders real components under every engine mode using pigmint-generated CSS vars.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate:tokens": "cd fixtures && node ../../cli/dist/bin.js build",
    "audit": "cd fixtures && node ../../cli/dist/bin.js audit",
    "predev": "pnpm run generate:tokens",
    "prebuild": "pnpm run generate:tokens",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pigmint/core": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@pigmint/cli": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.1",
    "vitest": "^2.0.0"
  }
}
