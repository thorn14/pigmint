{
  "name": "@pigmint/sticker-sheet-mui",
  "version": "0.0.0",
  "private": true,
  "description": "Verification surface for the MUI adapter. Renders real MUI components under every engine mode using the pigmint-generated theme object and validates runtime receipts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate:tokens": "cd fixtures && node ../../cli/dist/bin.js build",
    "predev": "pnpm run generate:tokens",
    "prebuild": "pnpm run generate:tokens",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.0",
    "@pigmint/adapter-mui": "workspace:*",
    "@pigmint/core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@pigmint/cli": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.1",
    "vitest": "^2.0.0"
  }
}
