{
  "name": "@pigmint/authoring-app",
  "version": "0.0.0",
  "private": true,
  "description": "Pigmint authoring UI — ramp editor, intent editor, and pigmint.yaml round-trip.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
