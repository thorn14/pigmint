{
  "name": "pigmint",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated color engine producing framework-portable design tokens with accessibility receipts.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @pigmint/authoring-app dev"
  }
}
