{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigmint.dev/schema/mode-entry-0.1.json",
  "title": "Pigmint mode entry",
  "description": "Shape of each entry under $extensions.com.pigmint.modes.<mode>.",
  "type": "object",
  "required": ["value"],
  "properties": {
    "value": {
      "type": "object",
      "description": "Multiple representations of the resolved color. oklch is source of truth.",
      "required": ["oklch"],
      "properties": {
        "oklch": { "type": "string", "description": "CSS oklch() string." },
        "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6,8}$" },
        "hsl": { "type": "string" },
        "p3": { "type": "string", "description": "CSS color(display-p3 ...) string." },
        "rgba": { "type": "string" },
        "colorMix": { "type": "string" }
      }
    },
    "source": { "$ref": "receipt.schema.json#/$defs/source" },
    "resolvedAgainst": {
      "anyOf": [
        { "type": "string", "description": "DTCG reference to a surface token." },
        { "type": "null" }
      ]
    },
    "contrast": { "$ref": "receipt.schema.json#/$defs/contrast" },
    "compliance": { "$ref": "receipt.schema.json#/$defs/compliance" },
    "gamut": { "$ref": "receipt.schema.json#/$defs/gamut" },
    "intent": { "type": "string", "description": "Reference or inline copy of the formal intent." },
    "cvd": { "type": "object", "additionalProperties": { "type": "string" } },
    "provenance": {
      "type": "object",
      "properties": {
        "vocabulary": { "type": "string" },
        "overlay": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "states": {
      "type": "object",
      "description": "Per-state receipts for tokens with interactive states.",
      "additionalProperties": { "$ref": "mode-entry.schema.json" }
    }
  }
}
