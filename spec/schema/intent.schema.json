{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigmint.dev/schema/intent-0.1.json",
  "title": "Pigmint formal intent",
  "description": "Formal intent consumed by the contrast-target resolver. Natural-language descriptions are out of scope — translated by the agent before the resolver sees them (ADR-014).",
  "type": "object",
  "required": ["threshold", "preference", "consistency", "surfaceContext"],
  "properties": {
    "threshold": {
      "type": "object",
      "required": ["kind", "level", "usage"],
      "properties": {
        "kind": { "enum": ["wcag", "apca"] },
        "level": { "enum": ["AA", "AAA"] },
        "usage": { "enum": ["text", "nonText"] }
      }
    },
    "preference": {
      "enum": ["lowest-passing", "highest-contrast", "matched-to-set", "anchored"]
    },
    "consistency": {
      "enum": ["independent", "matched-across-ramps", "anchored-to-reference"]
    },
    "surfaceContext": {
      "enum": ["primary", "elevated", "inverse", "current"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "anchor": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "description": "Reference to another token's resolved contrast." }
          ]
        },
        "minChroma": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "avoidPositions": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "gamutStrategy": { "enum": ["chroma-reduce", "chroma-preserve", "reject"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "preference": { "const": "matched-to-set" } } },
      "then": { "properties": { "consistency": { "not": { "const": "independent" } } } }
    },
    {
      "if": { "properties": { "preference": { "const": "anchored" } } },
      "then": { "required": ["constraints"] }
    }
  ]
}
