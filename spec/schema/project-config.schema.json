{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigmint.dev/schema/project-config-0.1.json",
  "title": "Pigmint project config",
  "description": "pigmint.yaml shape authored by the team.",
  "type": "object",
  "required": ["engine", "ramps", "output"],
  "properties": {
    "engine": {
      "type": "object",
      "required": ["compliance", "target", "modes"],
      "properties": {
        "compliance": { "enum": ["wcag21", "apca"] },
        "target": { "enum": ["AA", "AAA"] },
        "modes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "cvd": {
          "type": "array",
          "items": { "enum": ["deuteranopia", "protanopia", "tritanopia", "achromatopsia"] },
          "uniqueItems": true
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "vocabulary": { "type": "string" },
        "surfacePairs": { "type": "string" }
      }
    },
    "overlays": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ramps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "source": { "type": "string", "description": "Source hex or reference." },
          "curve": { "type": "string", "description": "Curve reference or inline params." }
        }
      }
    },
    "adapters": {
      "description": "Optional per ADR-018. Omit for DTCG-only output.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "output"],
        "properties": {
          "name": { "type": "string" },
          "output": { "type": "string" },
          "preset": { "type": "string" },
          "formats": {
            "type": "array",
            "items": { "type": "string" }
          },
          "alpha": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "referenceSurface": { "type": "string" }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["dtcg"],
      "properties": {
        "dtcg": { "type": "string" },
        "receiptsSidecar": { "type": "boolean" }
      }
    }
  }
}
