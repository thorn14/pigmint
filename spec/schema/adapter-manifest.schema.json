{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigmint.dev/schema/adapter-manifest-0.1.json",
  "title": "Pigmint adapter manifest",
  "description": "adapter.yaml shape shipped with each adapter package.",
  "type": "object",
  "required": ["name", "version", "enforcementMode", "supportedModes", "requiredRamps", "outputFormats"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "enforcementMode": { "enum": ["compile-time", "runtime", "advisory"] },
    "supportedModes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredRamps": {
      "type": "object",
      "required": ["minCount"],
      "properties": {
        "minCount": { "type": "integer", "minimum": 1 },
        "neutralRequired": { "type": "boolean" }
      }
    },
    "requiredPrimitives": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "array",
          "items": { "oneOf": [{ "type": "integer" }, { "type": "string" }] }
        },
        "minCount": { "type": "integer", "minimum": 1 }
      }
    },
    "outputFormats": {
      "type": "array",
      "items": { "enum": ["oklch", "hex", "hsl", "p3", "rgba", "colorMix"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "alpha": {
      "type": "object",
      "properties": {
        "supported": { "type": "boolean" },
        "modes": {
          "type": "array",
          "items": { "enum": ["precomposed", "rgba", "colorMix", "hex"] }
        },
        "default": { "type": "string" }
      }
    },
    "presets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supportedCategories": {
      "type": "array",
      "items": { "enum": ["action", "feedback", "surface", "foreground", "border", "focus", "decorative"] }
    },
    "runtimeValidator": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["shape", "package", "required"],
          "properties": {
            "shape": { "enum": ["react-hook", "babel-plugin", "runtime-proxy"] },
            "package": { "type": "string" },
            "required": { "type": "boolean" }
          }
        }
      ]
    },
    "muiVersionTarget": {
      "description": "Per OQ-11. Only meaningful for adapter-mui.",
      "enum": ["v5", "v6", "v7"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "enforcementMode": { "const": "runtime" } } },
      "then": {
        "properties": {
          "runtimeValidator": {
            "type": "object",
            "description": "Required when enforcementMode is runtime (ADR-020 for adapter-mui)."
          }
        }
      }
    }
  ]
}
