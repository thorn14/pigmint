{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigmint.dev/schema/vocabulary-token-0.1.json",
  "title": "Pigmint vocabulary entry",
  "description": "Shape of each entry in the canonical semantic vocabulary (see spec/09-vocabulary-v1.md).",
  "type": "object",
  "required": ["path", "usage"],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^color(\\.[a-zA-Z][a-zA-Z0-9-]*)+$",
      "description": "Fully qualified canonical DTCG path, e.g. color.action.primary.background."
    },
    "usage": { "enum": ["text", "nonText", "decorative"] },
    "primarySurface": {
      "type": "string",
      "description": "DTCG reference to a surface token. Required for text/nonText. Absent for decorative."
    },
    "additionalSurfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "defaultIntent": { "$ref": "intent.schema.json" },
    "states": {
      "type": "array",
      "items": { "enum": ["base", "hover", "active", "focus", "disabled"] },
      "uniqueItems": true,
      "minItems": 1
    },
    "statesForm": {
      "description": "Default expression form for states. Per-token override in overlays.",
      "enum": ["step-shift", "alpha-overlay"]
    },
    "description": { "type": "string" },
    "removed": {
      "type": "boolean",
      "description": "Overlay marker — skip this token during emission."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "usage": { "enum": ["text", "nonText"] } } },
      "then": { "required": ["primarySurface", "defaultIntent"] }
    },
    {
      "if": { "properties": { "usage": { "const": "decorative" } } },
      "then": { "not": { "required": ["defaultIntent"] } }
    }
  ]
}
